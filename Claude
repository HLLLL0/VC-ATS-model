// ═══════════════════════════════════════════════════════
// MAIN RUNNER
// ═══════════════════════════════════════════════════════
function runScreen() {
  let raw = '';
  if (activeTab === 'pdf') {
    if (!pdfText) { alert('Upload a PDF first, or switch to Paste Text.'); return; }
    raw = pdfText;
  } else {
    raw = document.getElementById('cvText').value;
  }
  if (raw.trim().length < 40) { alert('Paste more content to analyze.'); return; }

  const cv = raw;
  const cvL = raw.toLowerCase();
  const name = document.getElementById('candidateName').value.trim() || 'Candidate';

  // Score each layer
  const structRes = STRUCTURAL.map(s => ({ ...s, pass: s.test(cv) }));
  const structScore = structRes.reduce((a, s) => a + (s.pass ? s.pts : 0), 0);
  const structMax = STRUCTURAL.reduce((a, s) => a + s.pts, 0); // 14

  const wq = scoreWriting(cv);

  const compRes = COMPLETENESS.map(c => ({ ...c, pass: c.test(cv) }));
  const compScore = compRes.reduce((a, c) => a + (c.pass ? c.pts : 0), 0);
  const compMax = COMPLETENESS.reduce((a, c) => a + c.pts, 0); // 10

  const domainRes = DOMAIN_CATS.map(cat => {
    const criteria = cat.criteria.map(c => ({
      ...c, found: c.kw.some(k => cvL.includes(k))
    }));
    const earned = criteria.filter(c => c.found).reduce((a, c) => a + c.pts, 0);
    return { ...cat, criteria, earned };
  });

  // Compute final weighted score (100 pts)
  // Structure: 14→15, WQ: 15, Completeness: 10, Domain: 65 (10+15+15+15+10)
  const rawTotal = structScore + wq.score + compScore + domainRes.reduce((a, d) => a + d.earned, 0);
  const rawMax   = structMax + 15 + compMax + DOMAIN_CATS.reduce((a, d) => a + d.maxPts, 0);
  const score = Math.round((rawTotal / rawMax) * 100);

  // Flags
  const flags = RED_FLAGS.filter(f => f.test(cv));

  // Strengths & gaps from domain
  const strengths = [], gaps = [];
  domainRes.forEach(cat => {
    cat.criteria.forEach(c => {
      if (c.found) strengths.push({ label: c.label, cat: cat.name });
      else gaps.push({ label: c.label, cat: cat.name, pts: c.pts });
    });
  });
  gaps.sort((a, b) => b.pts - a.pts);

  // Add structural wins/fails to strengths/gaps
  structRes.forEach(s => {
    if (s.pass) strengths.push({ label: s.label, cat: 'ATS Structure' });
  });

  // Keywords
  const kwRes = KW_GROUPS.map(g => ({
    label: g.label,
    found: g.found.filter(k => cvL.includes(k)),
    missing: g.must.filter(k => !cvL.includes(k)),
  }));

  // Summary
  const summary = buildSummary(name, score, wq, domainRes, flags, cv);

  render(score, name, structScore, structMax, wq, compScore, compMax, domainRes, structRes, compRes, strengths, gaps, kwRes, flags, summary);
}

function buildSummary(name, score, wq, domainRes, flags, cv) {
  const aiCat = domainRes.find(d => d.id === 'ai');
  const finCat = domainRes.find(d => d.id === 'financial');
  const expCat = domainRes.find(d => d.id === 'experience');
  const aiPct  = Math.round(aiCat.earned  / aiCat.maxPts  * 100);
  const finPct = Math.round(finCat.earned / finCat.maxPts * 100);
  const expPct = Math.round(expCat.earned / expCat.maxPts * 100);

  let s = '';
  if      (score >= 78) s += `${name} is an exceptional match for a VC AI Analyst role. `;
  else if (score >= 60) s += `${name} is a solid candidate with most key criteria met. `;
  else if (score >= 42) s += `${name} is a borderline candidate with notable gaps. `;
  else                  s += `${name} does not yet meet the baseline for this role. `;

  if (aiPct >= 70)      s += `Strong AI/ML technical depth stands out. `;
  else if (aiPct <= 25) s += `Weak AI domain signals are a critical gap for an AI-focused role. `;

  if (finPct >= 70)     s += `Financial modeling and deal experience are well-documented. `;
  else if (finPct <= 25)s += `Thin financial/analytical evidence needs to be addressed. `;

  if (wq.quantCount >= 4)  s += `Good use of quantified achievements (${wq.quantCount} metric signals). `;
  else if (wq.quantCount === 0) s += `No quantified metrics detected — a major writing quality issue. `;

  if (wq.weakCount > 0)    s += `Weak/passive phrasing ("responsible for", etc.) found — recommend rewrite. `;
  if (wq.fpCount > 3)      s += `First-person pronouns should be removed. `;

  if (cv.toLowerCase().includes('founder') || cv.toLowerCase().includes('co-founder'))
    s += `Founder experience adds rare operational credibility. `;

  if (flags.length === 0)     s += `No structural red flags.`;
  else if (flags.length === 1) s += `1 red flag requires attention.`;
  else                         s += `${flags.length} red flags — resolve before advancing.`;

  return s;
}

// ═══════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════
function render(score, name, structScore, structMax, wq, compScore, compMax, domainRes, structRes, compRes, strengths, gaps, kwRes, flags, summary) {
  const results = document.getElementById('results');
  results.classList.add('show');

  // Arc
  const arc = document.getElementById('scoreArc');
  const circ = 264;
  setTimeout(() => {
    arc.style.strokeDashoffset = circ - (score / 100) * circ;
    arc.style.stroke = scoreColor(score);
  }, 60);
  const numEl = document.getElementById('scoreNum');
  numEl.textContent = score;
  numEl.style.color = scoreColor(score);

  // Candidate
  document.getElementById('candName').textContent = name;
  document.getElementById('summaryEl').textContent = summary;

  // Verdict
  const vEl = document.getElementById('verdictEl');
  let vText, vClass;
  if      (score >= 78) { vText = '⭐ Strong Hire'; vClass = 'v-hire'; }
  else if (score >= 60) { vText = '✅ Recommend Interview'; vClass = 'v-interview'; }
  else if (score >= 42) { vText = '⚠️ Borderline'; vClass = 'v-borderline'; }
  else                  { vText = '✗ Does Not Meet Bar'; vClass = 'v-reject'; }
  vEl.textContent = vText;
  vEl.className = `verdict ${vClass}`;

  // Pillars
  const totalDomain = domainRes.reduce((a, d) => a + d.earned, 0);
  const totalDomainMax = domainRes.reduce((a, d) => a + d.maxPts, 0);
  const pillars = [
    { label: 'ATS Structure', val: `${structScore}/${structMax}`, color: '#6366f1' },
    { label: 'Writing Quality', val: `${wq.score}/15`, color: '#06d6a0' },
    { label: 'Completeness', val: `${compScore}/${compMax}`, color: '#f59e0b' },
    { label: 'VC Domain Fit', val: `${totalDomain}/${totalDomainMax}`, color: '#a78bfa' },
  ];
  document.getElementById('pillarsEl').innerHTML = pillars.map(p => `
    <div class="pillar">
      <div class="pillar-dot" style="background:${p.color}"></div>
      <div class="pillar-label">${p.label}</div>
      <div class="pillar-val" style="color:${p.color}">${p.val}</div>
    </div>`).join('');

  // Category bars — include all layers
  const allCats = [
    { name: 'ATS Structure', earned: structScore, maxPts: structMax, color: '#6366f1' },
    { name: 'Writing Quality', earned: wq.score, maxPts: 15, color: '#06d6a0' },
    { name: 'Content Completeness', earned: compScore, maxPts: compMax, color: '#f59e0b' },
    ...domainRes.map(d => ({ name: d.name, earned: d.earned, maxPts: d.maxPts, color: d.color })),
  ];
  document.getElementById('catBarsEl').innerHTML = allCats.map(c => {
    const pct = Math.round(c.earned / c.maxPts * 100);
    return `<div class="cat-row">
      <div class="cat-top">
        <span class="cat-name" style="color:${c.color}">${c.name}</span>
        <span class="cat-score" style="color:${c.color}">${c.earned}/${c.maxPts}</span>
      </div>
      <div class="bar-bg"><div class="bar-fill" style="width:${pct}%;background:${c.color}"></div></div>
    </div>`;
  }).join('');

  // Strengths
  const sEl = document.getElementById('strengthsEl');
  if (!strengths.length) {
    sEl.innerHTML = '<li><div class="check-icon">—</div><div>None detected.</div></li>';
  } else {
    sEl.innerHTML = strengths.slice(0, 13).map(s => `
      <li>
        <div class="check-icon">✅</div>
        <div class="check-body">
          <div class="check-label">${s.label}</div>
          <div class="check-note">${s.cat}</div>
        </div>
      </li>`).join('');
  }

  // Gaps
  const gEl = document.getElementById('gapsEl');
  if (!gaps.length) {
    gEl.innerHTML = '<li><div class="check-icon">✅</div><div>No significant gaps.</div></li>';
  } else {
    gEl.innerHTML = gaps.slice(0, 13).map(g => `
      <li>
        <div class="check-icon">❌</div>
        <div class="check-body">
          <div class="check-label">${g.label}</div>
          <div class="check-note">${g.cat} · ${g.pts} pts</div>
        </div>
      </li>`).join('');
  }

  // ATS Structural signals
  const structEl = document.getElementById('structureEl');
  const allSignals = [
    ...structRes.map(s => ({ icon: s.pass ? s.icon : '⚠️', name: s.label, detail: s.pass ? 'Detected ✓' : s.fail, ok: s.pass })),
    ...compRes.map(c => ({ icon: c.pass ? '✓' : '○', name: c.label, detail: c.pass ? 'Present ✓' : c.note, ok: c.pass })),
  ];
  structEl.innerHTML = allSignals.map(s => `
    <div class="signal-item" style="border-color:${s.ok ? 'rgba(6,214,160,0.2)' : 'rgba(244,63,94,0.18)'}">
      <div class="signal-icon">${s.icon}</div>
      <div class="signal-text">
        <div class="signal-name" style="color:${s.ok ? 'var(--green)' : 'var(--danger)'}">${s.name}</div>
        <div class="signal-detail">${s.detail}</div>
      </div>
    </div>`).join('');

  // Writing quality
  const avPct  = Math.round(wq.avScore / 10 * 100);
  const qPct   = Math.round(wq.quantScore / 8 * 100);
  const wData = [
    { name: 'Action verbs', val: wq.avCount, max: '10+', pct: avPct, detail: `${wq.avCount} strong verbs found`, good: wq.avCount >= 7, ok: wq.avCount >= 4 },
    { name: 'Quantified achievements', val: wq.quantCount, max: '8+', pct: qPct, detail: `${wq.quantCount} numeric metrics found`, good: wq.quantCount >= 5, ok: wq.quantCount >= 2 },
    { name: 'Weak/passive phrases', val: wq.weakCount, max: '0', pct: 0, detail: wq.weakCount === 0 ? 'None detected ✓' : `${wq.weakCount} instance(s): "responsible for", etc.`, good: wq.weakCount === 0, ok: wq.weakCount <= 1, invert: true },
    { name: 'First-person pronouns', val: wq.fpCount, max: '0', pct: 0, detail: wq.fpCount === 0 ? 'None detected ✓' : `${wq.fpCount} instances of I/me/my`, good: wq.fpCount === 0, ok: wq.fpCount <= 2, invert: true },
    { name: 'Filler words', val: wq.fillerCount, max: '0', pct: 0, detail: wq.fillerCount === 0 ? 'None detected ✓' : `${wq.fillerCount} filler word(s) detected`, good: wq.fillerCount === 0, ok: wq.fillerCount <= 2, invert: true },
    { name: 'Bullet points', val: wq.bullets, max: '6+', pct: Math.min(wq.bullets / 10 * 100, 100), detail: `${wq.bullets} bullet points detected`, good: wq.bullets >= 6, ok: wq.bullets >= 3 },
  ];
  document.getElementById('writingEl').innerHTML = wData.map(w => {
    const tag = w.good ? 'good' : w.ok ? 'ok' : 'bad';
    const tagText = w.good ? 'Good' : w.ok ? 'Acceptable' : 'Needs Work';
    const barColor = w.good ? 'var(--green)' : w.ok ? 'var(--warn)' : 'var(--danger)';
    const barPct = w.pct ?? 0;
    return `<div class="wq-item">
      <div class="wq-top">
        <span class="wq-name">${w.name}</span>
        <span class="wq-tag ${tag}">${tagText}</span>
      </div>
      <div class="bar-bg" style="margin-bottom:3px">
        <div class="bar-fill" style="width:${Math.min(barPct,100)}%;background:${barColor}"></div>
      </div>
      <div style="font-size:11px;color:var(--muted)">${w.detail}</div>
    </div>`;
  }).join('');

  // Keywords
  document.getElementById('keywordsEl').innerHTML = kwRes.map(g => `
    <div style="margin-bottom:14px">
      <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);margin-bottom:7px">${g.label}</div>
      <div class="chip-wrap">
        ${g.found.map(k => `<span class="chip hit">${k}</span>`).join('')}
        ${g.missing.map(k => `<span class="chip miss">${k} ✗</span>`).join('')}
        ${!g.found.length && !g.missing.length ? '<span style="font-size:12px;color:var(--muted)">No keywords detected</span>' : ''}
      </div>
    </div>`).join('');

  // Red flags
  const fEl = document.getElementById('flagsEl');
  if (!flags.length) {
    fEl.innerHTML = `<div class="no-flags">✅ No red flags detected. Structurally clean resume.</div>`;
  } else {
    fEl.innerHTML = flags.map(f => `
      <div class="flag-item">
        <strong>⚑ ${f.label}</strong>
        <div class="flag-note">${f.note}</div>
      </div>`).join('');
  }

  results.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function scoreColor(s) {
  if (s >= 78) return '#06d6a0';
  if (s >= 60) return '#6366f1';
  if (s >= 42) return '#f59e0b';
  return '#f43f5e';
}

function clearAll() {
  pdfText = '';
  document.getElementById('candidateName').value = '';
  document.getElementById('cvText').value = '';
  document.getElementById('pdfInput').value = '';
  document.getElementById('uploadStatus').style.display = 'none';
  document.getElementById('pdfSnippet').classList.remove('show');
  document.getElementById('pdfSnippet').textContent = '';
  document.getElementById('ocrProgress').classList.remove('show');
  document.getElementById('ocrBar').style.width = '0%';
  document.getElementById('imgPreview').classList.remove('show');
  document.getElementById('imgThumb').src = '';
  document.getElementById('dropIcon').textContent = '📂';
  document.getElementById('results').classList.remove('show');
}
</script>
