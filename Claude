<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VC AI Analyst — ATS Screener</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tesseract.js/4.1.1/tesseract.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<style>
:root {
  --bg: #0d0f18;
  --surface: #13162a;
  --surface2: #1c2040;
  --border: #252a4a;
  --accent: #6366f1;
  --accent2: #06d6a0;
  --danger: #f43f5e;
  --warn: #f59e0b;
  --text: #e2e8f0;
  --muted: #7c85b3;
  --green: #06d6a0;
  --purple: #a78bfa;
  --pink: #ec4899;
  --radius: 14px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: -apple-system, 'Inter', 'Segoe UI', sans-serif; min-height: 100vh; }

/* ── HEADER ── */
header {
  background: linear-gradient(135deg, #13162a 0%, #0d0f18 60%);
  border-bottom: 1px solid var(--border);
  padding: 20px 40px;
  display: flex; align-items: center; justify-content: space-between;
}
.header-left { display: flex; align-items: center; gap: 14px; }
.logo { font-size: 20px; font-weight: 900; letter-spacing: -0.5px; }
.logo span { color: var(--accent); }
.badge { background: var(--accent); color: white; font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.6px; }
.header-right { font-size: 12px; color: var(--muted); text-align: right; line-height: 1.6; }

.container { max-width: 1380px; margin: 0 auto; padding: 30px 40px; }

/* ── INPUT PANEL ── */
.input-panel {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 26px; margin-bottom: 26px;
}
.input-panel h2 { font-size: 15px; font-weight: 800; margin-bottom: 4px; }
.input-panel p { font-size: 12px; color: var(--muted); margin-bottom: 18px; line-height: 1.5; }

.tab-row { display: flex; border: 1px solid var(--border); border-radius: 9px; overflow: hidden; margin-bottom: 16px; width: fit-content; }
.tab-btn { padding: 8px 20px; background: transparent; color: var(--muted); border: none; font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s; }
.tab-btn.active { background: var(--accent); color: white; }

.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* PDF Upload */
.drop-zone {
  border: 2px dashed var(--border); border-radius: 10px;
  padding: 36px; text-align: center; cursor: pointer; position: relative;
  transition: all 0.2s;
}
.drop-zone:hover, .drop-zone.over { border-color: var(--accent); background: rgba(99,102,241,0.06); }
.drop-zone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.drop-icon { font-size: 32px; margin-bottom: 8px; }
.drop-title { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
.drop-sub { font-size: 12px; color: var(--muted); }
.upload-status { margin-top: 10px; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
.upload-status.ok { color: var(--green); }
.upload-status.loading { color: var(--accent); }
.upload-status.err { color: var(--danger); }
.pdf-snippet {
  margin-top: 10px; background: var(--bg); border: 1px solid var(--border);
  border-radius: 8px; padding: 12px; font-size: 11px; color: var(--muted);
  max-height: 100px; overflow-y: auto; white-space: pre-wrap; font-family: monospace;
  line-height: 1.5; display: none;
}
.pdf-snippet.show { display: block; }

/* Supported file type badges */
.filetype-strip { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; justify-content: center; }
.ft-badge {
  padding: 2px 9px; border-radius: 5px; font-size: 10px; font-weight: 800;
  background: var(--surface2); color: var(--muted); border: 1px solid var(--border);
  text-transform: uppercase; letter-spacing: 0.4px;
}
.ft-badge.active { background: rgba(99,102,241,0.12); color: var(--accent); border-color: rgba(99,102,241,0.3); }

/* OCR progress bar */
.ocr-progress { margin-top: 10px; display: none; }
.ocr-progress.show { display: block; }
.ocr-bar-wrap { background: var(--bg); border-radius: 4px; height: 5px; margin-top: 6px; }
.ocr-bar-fill { height: 5px; border-radius: 4px; background: var(--accent); transition: width 0.3s ease; width: 0%; }
.ocr-label { font-size: 11px; color: var(--muted); }

/* Image preview thumbnail */
.img-preview { margin-top: 10px; display: none; }
.img-preview.show { display: flex; gap: 12px; align-items: flex-start; }
.img-thumb { width: 90px; height: 120px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); flex-shrink: 0; }
.img-meta { font-size: 11px; color: var(--muted); line-height: 1.7; }

/* Text area */
.cv-area {
  width: 100%; min-height: 200px; background: var(--bg); border: 1.5px solid var(--border);
  border-radius: 9px; color: var(--text); font-size: 13px; line-height: 1.6;
  padding: 14px 16px; resize: vertical; outline: none; font-family: inherit;
  transition: border-color 0.2s;
}
.cv-area:focus { border-color: var(--accent); }
.cv-area::placeholder { color: var(--muted); }

.input-row { display: flex; gap: 10px; margin-top: 14px; align-items: center; }
.name-input {
  flex: 1; background: var(--bg); border: 1.5px solid var(--border); border-radius: 8px;
  color: var(--text); font-size: 13px; padding: 10px 14px; outline: none; font-family: inherit;
  transition: border-color 0.2s;
}
.name-input:focus { border-color: var(--accent); }
.name-input::placeholder { color: var(--muted); }
.btn-primary {
  background: linear-gradient(135deg, var(--accent), #8b5cf6);
  color: white; border: none; padding: 10px 26px; border-radius: 8px;
  font-size: 13px; font-weight: 800; cursor: pointer;
  transition: opacity 0.15s, transform 0.1s; white-space: nowrap;
}
.btn-primary:hover { opacity: 0.88; transform: translateY(-1px); }
.btn-ghost {
  background: transparent; border: 1.5px solid var(--border); color: var(--muted);
  padding: 10px 18px; border-radius: 8px; font-size: 13px; cursor: pointer; transition: all 0.2s;
}
.btn-ghost:hover { border-color: var(--muted); color: var(--text); }

/* ── RESULTS ── */
#results { display: none; }
#results.show { display: block; }

/* Score hero */
.score-hero {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 24px 28px; margin-bottom: 20px;
  display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center;
}
.score-ring { width: 100px; height: 100px; position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.score-ring svg { position: absolute; top: 0; left: 0; transform: rotate(-90deg); }
.score-center { text-align: center; position: relative; z-index: 1; }
.score-num { font-size: 28px; font-weight: 900; line-height: 1; }
.score-denom { font-size: 11px; color: var(--muted); }

.score-meta .cand-name { font-size: 22px; font-weight: 900; margin-bottom: 6px; }
.verdict { display: inline-flex; align-items: center; gap: 6px; padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px; }
.verdict.v-hire { background: rgba(6,214,160,0.12); color: var(--green); border: 1px solid rgba(6,214,160,0.28); }
.verdict.v-interview { background: rgba(99,102,241,0.12); color: var(--accent); border: 1px solid rgba(99,102,241,0.28); }
.verdict.v-borderline { background: rgba(245,158,11,0.12); color: var(--warn); border: 1px solid rgba(245,158,11,0.28); }
.verdict.v-reject { background: rgba(244,63,94,0.12); color: var(--danger); border: 1px solid rgba(244,63,94,0.28); }
.summary-text { font-size: 13px; line-height: 1.7; color: var(--muted); max-width: 680px; }

.score-pillars { display: flex; flex-direction: column; gap: 8px; min-width: 200px; }
.pillar { display: flex; align-items: center; gap: 8px; }
.pillar-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.pillar-label { font-size: 11px; color: var(--muted); flex: 1; }
.pillar-val { font-size: 11px; font-weight: 700; }

/* Grid layouts */
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 16px; }

/* Cards */
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 20px;
}
.card-title {
  font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.7px;
  color: var(--muted); margin-bottom: 14px; display: flex; align-items: center; gap: 6px;
}
.card-title .ctag {
  background: var(--surface2); padding: 2px 8px; border-radius: 4px;
  font-size: 10px; font-weight: 700;
}

/* Category bars */
.cat-row { margin-bottom: 12px; }
.cat-row:last-child { margin-bottom: 0; }
.cat-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 5px; }
.cat-name { font-size: 12px; font-weight: 700; }
.cat-score { font-size: 12px; font-weight: 800; }
.bar-bg { background: var(--bg); border-radius: 4px; height: 6px; }
.bar-fill { height: 6px; border-radius: 4px; transition: width 0.9s cubic-bezier(.25,.46,.45,.94); }

/* Check lists */
.check-list { list-style: none; }
.check-list li {
  display: flex; align-items: flex-start; gap: 9px;
  padding: 7px 0; border-bottom: 1px solid rgba(37,42,74,0.7); font-size: 12px; line-height: 1.5;
}
.check-list li:last-child { border-bottom: none; }
.check-icon { flex-shrink: 0; font-size: 13px; margin-top: 0px; }
.check-body {}
.check-label { font-weight: 700; }
.check-note { color: var(--muted); font-size: 11px; margin-top: 1px; }

/* Keyword chips */
.chip-wrap { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
.chip.hit { background: rgba(6,214,160,0.1); color: var(--green); border: 1px solid rgba(6,214,160,0.22); }
.chip.miss { background: rgba(244,63,94,0.09); color: var(--danger); border: 1px solid rgba(244,63,94,0.18); }

/* ATS Signals mini-cards */
.signal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.signal-item {
  background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
  padding: 10px 12px; display: flex; align-items: flex-start; gap: 8px;
}
.signal-icon { font-size: 15px; flex-shrink: 0; }
.signal-text {}
.signal-name { font-size: 11px; font-weight: 700; }
.signal-detail { font-size: 10px; color: var(--muted); margin-top: 1px; }

/* Writing quality meter */
.wq-item { margin-bottom: 10px; }
.wq-item:last-child { margin-bottom: 0; }
.wq-top { display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 4px; }
.wq-name { font-weight: 700; }
.wq-tag { font-weight: 700; }
.wq-tag.good { color: var(--green); }
.wq-tag.ok { color: var(--warn); }
.wq-tag.bad { color: var(--danger); }

/* Flags */
.flag-item {
  background: rgba(244,63,94,0.06); border: 1px solid rgba(244,63,94,0.18);
  border-radius: 8px; padding: 10px 13px; margin-bottom: 7px; font-size: 12px;
}
.flag-item:last-child { margin-bottom: 0; }
.flag-item strong { color: var(--danger); }
.flag-note { color: var(--muted); font-size: 11px; margin-top: 3px; }

.no-flags { color: var(--green); font-size: 12px; display: flex; align-items: center; gap: 7px; }

.section-divider { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin: 20px 0 12px; padding-left: 2px; }

footer { text-align: center; color: var(--muted); font-size: 11px; padding: 28px 40px; line-height: 1.7; }
footer a { color: var(--muted); }

@media (max-width: 1000px) {
  .grid-3, .grid-4 { grid-template-columns: 1fr 1fr; }
  .score-hero { grid-template-columns: auto 1fr; }
  .score-pillars { display: none; }
}
@media (max-width: 700px) {
  .grid-3, .grid-4, .grid-2 { grid-template-columns: 1fr; }
  .container, header { padding: 16px 18px; }
  .score-hero { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<header>
  <div class="header-left">
    <div class="logo">VC<span>Screen</span></div>
    <div class="badge">AI Analyst ATS · v2</div>
  </div>
  <div class="header-right">
    Modeled on Greenhouse · Lever · Workday scoring logic<br>
    VC criteria: Plug &amp; Play · Truebridge Capital · industry benchmarks
  </div>
</header>

<div class="container">

  <!-- INPUT -->
  <div class="input-panel">
    <h2>Screen a Candidate</h2>
    <p>Upload a PDF resume or paste CV text. Scored across 8 dimensions — ATS structural parsing, writing quality, grammar signals, content completeness, and VC domain fit.</p>

    <div class="tab-row">
      <button class="tab-btn active" onclick="switchTab('pdf')">📄 Upload PDF</button>
      <button class="tab-btn" onclick="switchTab('text')">📋 Paste Text</button>
    </div>

    <div class="tab-panel active" id="tab-pdf">
      <div class="drop-zone" id="dropZone"
           ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
        <input type="file"
          accept=".pdf,.jpg,.jpeg,.png,.webp,.gif,.bmp,.tiff,.tif,.docx,.doc,.txt"
          id="pdfInput" onchange="onFileSelect(event)">
        <div class="drop-icon" id="dropIcon">📂</div>
        <div class="drop-title">Drop any resume file here or click to browse</div>
        <div class="drop-sub">All processing is local · Never uploaded to any server</div>
        <div class="filetype-strip">
          <span class="ft-badge active">PDF</span>
          <span class="ft-badge active">JPG</span>
          <span class="ft-badge active">PNG</span>
          <span class="ft-badge active">WEBP</span>
          <span class="ft-badge active">GIF</span>
          <span class="ft-badge active">BMP</span>
          <span class="ft-badge active">TIFF</span>
          <span class="ft-badge active">DOCX</span>
          <span class="ft-badge active">TXT</span>
        </div>
      </div>
      <div class="upload-status" id="uploadStatus" style="display:none"></div>
      <div class="ocr-progress" id="ocrProgress">
        <div class="ocr-label" id="ocrLabel">Running OCR…</div>
        <div class="ocr-bar-wrap"><div class="ocr-bar-fill" id="ocrBar"></div></div>
      </div>
      <div class="img-preview" id="imgPreview">
        <img class="img-thumb" id="imgThumb" src="" alt="preview">
        <div class="img-meta" id="imgMeta"></div>
      </div>
      <div class="pdf-snippet" id="pdfSnippet"></div>
    </div>

    <div class="tab-panel" id="tab-text">
      <textarea class="cv-area" id="cvText" placeholder="Paste full resume text here…

Jane Smith  |  jane@email.com  |  +1 415-555-0199  |  linkedin.com/in/janesmith

EDUCATION
Stanford University — BS Computer Science, GPA 3.9 (2020)
Harvard Business School — MBA, Baker Scholar (2023)

EXPERIENCE
Sequoia Capital — Investment Analyst  (Jun 2023 – Present)
• Sourced 80+ early-stage deals across AI/ML, SaaS, and fintech verticals
• Built DCF and comparable company financial models for 12 portfolio companies
• Led due diligence on Series A/B rounds; authored 6 investment memos for IC

SKILLS
Financial modeling · Python · SQL · PitchBook · LLM infrastructure · NLP"></textarea>
    </div>

    <div class="input-row">
      <input class="name-input" id="candidateName" placeholder="Candidate name (auto-detected from PDF)">
      <button class="btn-ghost" onclick="clearAll()">Clear</button>
      <button class="btn-primary" onclick="runScreen()">▶ Screen Candidate</button>
    </div>
  </div>

  <!-- RESULTS -->
  <div id="results">

    <!-- HERO -->
    <div class="score-hero">
      <div class="score-ring">
        <svg width="100" height="100" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="42" fill="none" stroke="#252a4a" stroke-width="9"/>
          <circle id="scoreArc" cx="50" cy="50" r="42" fill="none" stroke-width="9"
            stroke-dasharray="264" stroke-dashoffset="264" stroke-linecap="round"
            style="transition: stroke-dashoffset 1s ease, stroke 0.4s ease;"/>
        </svg>
        <div class="score-center">
          <div class="score-num" id="scoreNum">--</div>
          <div class="score-denom">/ 100</div>
        </div>
      </div>
      <div class="score-meta">
        <div class="cand-name" id="candName">—</div>
        <div id="verdictEl" class="verdict">—</div>
        <div class="summary-text" id="summaryEl">—</div>
      </div>
      <div class="score-pillars" id="pillarsEl"></div>
    </div>

    <!-- ROW 1: Category bars + qualified + gaps -->
    <div class="grid-3">
      <div class="card">
        <div class="card-title">📊 Score Breakdown</div>
        <div id="catBarsEl"></div>
      </div>
      <div class="card">
        <div class="card-title">✅ Qualified Attributes</div>
        <ul class="check-list" id="strengthsEl"></ul>
      </div>
      <div class="card">
        <div class="card-title">❌ Gaps &amp; Missing Criteria</div>
        <ul class="check-list" id="gapsEl"></ul>
      </div>
    </div>

    <!-- ROW 2: ATS structural + writing quality -->
    <div class="grid-2">
      <div class="card">
        <div class="card-title">🔍 ATS Structural Checks <span class="ctag">Greenhouse / Workday logic</span></div>
        <div class="signal-grid" id="structureEl"></div>
      </div>
      <div class="card">
        <div class="card-title">✍️ Writing Quality Analysis</div>
        <div id="writingEl"></div>
      </div>
    </div>

    <!-- ROW 3: Keywords + red flags -->
    <div class="grid-2">
      <div class="card">
        <div class="card-title">🔑 Keyword Signal</div>
        <div id="keywordsEl"></div>
      </div>
      <div class="card">
        <div class="card-title">🚩 Red Flags</div>
        <div id="flagsEl"></div>
      </div>
    </div>

  </div>
</div>

<footer>
  VCScreen AI Analyst ATS — scoring modeled on Greenhouse, Lever, Workday, and Jobscan rubrics.<br>
  Domain criteria sourced from Plug &amp; Play Tech Center, Truebridge Capital, <a href="https://venturecapitalcareers.com">VentureCapitalCareers.com</a>, and industry benchmarks.<br>
  All processing is local — no resume data is transmitted.
</footer>

<script>
// ═══════════════════════════════════════════════════════
// LIBRARY SETUP
// ═══════════════════════════════════════════════════════
if (typeof pdfjsLib !== 'undefined') {
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
}

let pdfText = '';
let activeTab = 'pdf';

const IMAGE_TYPES = ['image/jpeg','image/jpg','image/png','image/webp','image/gif','image/bmp','image/tiff','image/x-tiff'];
const IMAGE_EXTS  = ['.jpg','.jpeg','.png','.webp','.gif','.bmp','.tiff','.tif'];

function getFileType(file) {
  const name = file.name.toLowerCase();
  if (file.type === 'application/pdf' || name.endsWith('.pdf')) return 'pdf';
  if (IMAGE_TYPES.includes(file.type) || IMAGE_EXTS.some(e => name.endsWith(e))) return 'image';
  if (file.type.includes('wordprocessingml') || name.endsWith('.docx') || name.endsWith('.doc')) return 'docx';
  if (file.type === 'text/plain' || name.endsWith('.txt')) return 'txt';
  return 'unknown';
}

function switchTab(t) {
  activeTab = t;
  document.querySelectorAll('.tab-btn').forEach((b, i) =>
    b.classList.toggle('active', (i === 0 && t === 'pdf') || (i === 1 && t === 'text')));
  document.getElementById('tab-pdf').classList.toggle('active', t === 'pdf');
  document.getElementById('tab-text').classList.toggle('active', t === 'text');
}

function onDragOver(e) { e.preventDefault(); document.getElementById('dropZone').classList.add('over'); }
function onDragLeave() { document.getElementById('dropZone').classList.remove('over'); }
function onDrop(e) {
  e.preventDefault(); document.getElementById('dropZone').classList.remove('over');
  const f = e.dataTransfer.files[0];
  if (f) parseFile(f);
  else showStatus('err', '✗ No file detected.');
}
function onFileSelect(e) { if (e.target.files[0]) parseFile(e.target.files[0]); }

// ── ROUTER ──
async function parseFile(file) {
  resetUploadUI();
  const type = getFileType(file);
  if      (type === 'pdf')   await parsePDF(file);
  else if (type === 'image') await parseImage(file);
  else if (type === 'docx')  await parseDocx(file);
  else if (type === 'txt')   await parseTxt(file);
  else showStatus('err', `✗ Unsupported file type: "${file.name}". Use PDF, JPG, PNG, WEBP, GIF, BMP, TIFF, DOCX, or TXT.`);
}

function resetUploadUI() {
  pdfText = '';
  showStatus('loading', '⏳ Processing file…');
  document.getElementById('pdfSnippet').classList.remove('show');
  document.getElementById('ocrProgress').classList.remove('show');
  document.getElementById('imgPreview').classList.remove('show');
}

// ── PDF ──
async function parsePDF(file) {
  showStatus('loading', '⏳ Extracting PDF text…');
  try {
    const buf = await file.arrayBuffer();
    const pdf = await pdfjsLib.getDocument({ data: buf }).promise;
    let text = '';
    for (let p = 1; p <= pdf.numPages; p++) {
      const page = await pdf.getPage(p);
      const content = await page.getTextContent();
      text += content.items.map(i => i.str).join(' ') + '\n';
    }
    pdfText = text.trim();
    if (!pdfText) {
      // Scanned PDF — fall back to OCR via rendering pages as canvas
      showStatus('loading', '⏳ Scanned PDF detected — running OCR on pages…');
      let ocrText = '';
      for (let p = 1; p <= pdf.numPages; p++) {
        const page = await pdf.getPage(p);
        const vp = page.getViewport({ scale: 2.0 });
        const canvas = document.createElement('canvas');
        canvas.width = vp.width; canvas.height = vp.height;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
        const pageText = await runOCR(canvas, `Page ${p}/${pdf.numPages}`);
        ocrText += pageText + '\n';
      }
      pdfText = ocrText.trim();
      if (!pdfText) { showStatus('err', '✗ Could not extract text from this PDF.'); return; }
      document.getElementById('dropIcon').textContent = '📄';
      finishExtraction(file.name, `${pdf.numPages} pages · OCR`);
      return;
    }
    document.getElementById('dropIcon').textContent = '📄';
    finishExtraction(file.name, `${pdf.numPages} page${pdf.numPages > 1 ? 's' : ''} · text layer`);
  } catch(err) {
    showStatus('err', '✗ PDF parse error: ' + err.message);
  }
}

// ── IMAGE (JPG, PNG, WEBP, GIF, BMP, TIFF, screenshots) ──
async function parseImage(file) {
  showStatus('loading', '⏳ Loading image…');
  const url = URL.createObjectURL(file);

  // Show thumbnail
  const thumb = document.getElementById('imgThumb');
  thumb.src = url;
  const meta = document.getElementById('imgMeta');
  meta.innerHTML = `<strong>${file.name}</strong><br>${(file.size/1024).toFixed(0)} KB<br>Type: ${file.type || 'image'}<br><br>Running OCR…`;
  document.getElementById('imgPreview').classList.add('show');

  try {
    pdfText = await runOCR(url, 'image');
    if (!pdfText.trim()) { showStatus('err', '✗ No text found in image. Ensure the image is clear and not blurry.'); return; }
    meta.innerHTML = `<strong>${file.name}</strong><br>${(file.size/1024).toFixed(0)} KB<br>Type: ${file.type || 'image'}<br>Words extracted: <strong>${pdfText.split(/\s+/).length}</strong>`;
    document.getElementById('dropIcon').textContent = '🖼️';
    finishExtraction(file.name, `image · OCR · ${pdfText.split(/\s+/).length} words`);
    URL.revokeObjectURL(url);
  } catch(err) {
    showStatus('err', '✗ OCR failed: ' + err.message);
    URL.revokeObjectURL(url);
  }
}

// ── OCR RUNNER (Tesseract.js) ──
async function runOCR(source, label) {
  const prog = document.getElementById('ocrProgress');
  const bar  = document.getElementById('ocrBar');
  const lbl  = document.getElementById('ocrLabel');
  prog.classList.add('show');
  lbl.textContent = `Running OCR on ${label}…`;
  bar.style.width = '0%';

  const result = await Tesseract.recognize(source, 'eng', {
    logger: m => {
      if (m.status === 'recognizing text') {
        const pct = Math.round(m.progress * 100);
        bar.style.width = pct + '%';
        lbl.textContent = `OCR: ${label} — ${pct}%`;
      }
    }
  });

  bar.style.width = '100%';
  lbl.textContent = `✅ OCR complete`;
  return result.data.text;
}

// ── DOCX ──
async function parseDocx(file) {
  showStatus('loading', '⏳ Reading Word document…');
  try {
    const buf = await file.arrayBuffer();
    const result = await mammoth.extractRawText({ arrayBuffer: buf });
    pdfText = result.value.trim();
    if (!pdfText) { showStatus('err', '✗ No text found in document.'); return; }
    document.getElementById('dropIcon').textContent = '📝';
    finishExtraction(file.name, `Word document · ${pdfText.split(/\s+/).length} words`);
  } catch(err) {
    showStatus('err', '✗ DOCX parse error: ' + err.message);
  }
}

// ── TXT ──
async function parseTxt(file) {
  showStatus('loading', '⏳ Reading text file…');
  try {
    pdfText = await file.text();
    pdfText = pdfText.trim();
    if (!pdfText) { showStatus('err', '✗ File appears empty.'); return; }
    document.getElementById('dropIcon').textContent = '📋';
    finishExtraction(file.name, `plain text · ${pdfText.split(/\s+/).length} words`);
  } catch(err) {
    showStatus('err', '✗ Read error: ' + err.message);
  }
}

// ── SHARED FINISH ──
function finishExtraction(filename, detail) {
  // Auto-detect name
  const firstLine = pdfText.split('\n')[0].trim().replace(/\s+/g, ' ');
  const nameEl = document.getElementById('candidateName');
  if (!nameEl.value && firstLine.length < 65 && /^[A-Z][a-zA-Z]/.test(firstLine) && !/@/.test(firstLine))
    nameEl.value = firstLine;

  const words = pdfText.split(/\s+/).length;
  showStatus('ok', `✅ ${filename} · ${detail}`);
  const snip = document.getElementById('pdfSnippet');
  snip.textContent = pdfText.slice(0, 600) + (pdfText.length > 600 ? '\n…' : '');
  snip.classList.add('show');
}

function showStatus(type, msg) {
  const el = document.getElementById('uploadStatus');
  el.style.display = 'flex';
