// ─── 1. ATS STRUCTURAL (15 pts) ───
const STRUCTURAL = [
  { id: 'email',     label: 'Email address present',      icon: '📧', test: cv => /[\w.+-]+@[\w.-]+\.\w{2,}/.test(cv),           pts: 2, fail: 'Missing contact email — fails Greenhouse/Workday contact parser.' },
  { id: 'phone',     label: 'Phone number present',       icon: '📞', test: cv => /(\+?1[\s.-]?)?\(?\d{3}\)?[\s.-]\d{3}[\s.-]\d{4}/.test(cv), pts: 1, fail: 'No phone number detected.' },
  { id: 'linkedin',  label: 'LinkedIn URL present',       icon: '🔗', test: cv => /linkedin\.com\/in\//i.test(cv),               pts: 2, fail: 'No LinkedIn URL — expected by most VC ATS platforms.' },
  { id: 'edu_sec',   label: 'Education section header',   icon: '🎓', test: cv => /\beducation\b/i.test(cv),                     pts: 2, fail: 'No "Education" section header — parser may fail to map degree.' },
  { id: 'exp_sec',   label: 'Experience section header',  icon: '💼', test: cv => /\b(experience|work history|employment)\b/i.test(cv), pts: 2, fail: 'No "Experience" section — critical for Workday/Greenhouse field mapping.' },
  { id: 'skills_sec',label: 'Skills section present',     icon: '🛠',  test: cv => /\bskills\b/i.test(cv),                        pts: 2, fail: 'No Skills section — reduces ATS keyword density score.' },
  { id: 'dates',     label: 'Employment dates present',   icon: '📅', test: cv => /\b(19|20)\d{2}\b/.test(cv),                   pts: 2, fail: 'No employment dates found — Greenhouse flags this as incomplete.' },
  { id: 'length',    label: 'Resume length appropriate',  icon: '📏', test: cv => { const w = cv.split(/\s+/).length; return w >= 150 && w <= 1200; }, pts: 2, fail: 'Resume is too short (<150 words) or too long (>1200) — outside ATS optimal range.' },
];

// ─── 2. WRITING QUALITY (15 pts — computed as score, not pass/fail) ───
const ACTION_VERBS = [
  'led','built','launched','created','drove','developed','designed','managed','executed',
  'delivered','increased','reduced','improved','scaled','implemented','analyzed','sourced',
  'authored','negotiated','partnered','collaborated','presented','identified','evaluated',
  'generated','deployed','established','restructured','optimized','accelerated','spearheaded',
  'championed','secured','raised','recruited','mentored','advised',
];
const WEAK_PHRASES = [
  'responsible for','helped with','worked on','assisted with','participated in',
  'was involved in','helped to','duties included','tasks included','was part of',
  'exposed to','familiar with','knowledge of','understanding of',
];
const FILLER_WORDS = ['very','really','just','actually','basically','literally','simply','definitely'];
const FIRST_PERSON = /\b(i |i've|i'm|i'd|i'll|my |me )\b/gi;

function scoreWriting(cv) {
  const lower = cv.toLowerCase();
  const words = cv.split(/\s+/);
  const bullets = (cv.match(/^[\s]*[•\-\*•]\s+.+/gm) || []);

  // Action verbs — how many bullets start with one
  let avCount = 0;
  ACTION_VERBS.forEach(v => { const r = new RegExp('\\b' + v + '\\b', 'i'); if (r.test(cv)) avCount++; });
  const avScore = Math.min(avCount, 10); // cap at 10 verbs

  // Quantification
  const quantMatches = cv.match(/\d+[\s]?[%$xX]|\$[\d,.]+|\d+[\s]?(million|billion|M\b|B\b|k\b|deals|companies|startups|portfolio|rounds|models|memos|reports)/gi) || [];
  const quantScore = Math.min(quantMatches.length, 8);

  // Weak phrases penalty
  let weakCount = 0;
  WEAK_PHRASES.forEach(p => { if (lower.includes(p)) weakCount++; });

  // First-person penalty
  const fpCount = (cv.match(FIRST_PERSON) || []).length;

  // Filler words
  let fillerCount = 0;
  FILLER_WORDS.forEach(w => { const r = new RegExp('\\b' + w + '\\b', 'gi'); const m = cv.match(r); if (m) fillerCount += m.length; });

  // Consistency: past tense verbs in past roles
  const pastVerbs = (cv.match(/\b(led|built|launched|created|developed|managed|delivered|improved|scaled|implemented|analyzed|authored|sourced|negotiated|generated|established|designed)\b/gi) || []).length;

  // Compute writing score out of 15
  let score = 0;
  score += Math.round((avScore / 10) * 5);      // 0-5 pts: action verbs
  score += Math.round((quantScore / 8) * 5);    // 0-5 pts: quantification
  score += weakCount === 0 ? 3 : weakCount <= 1 ? 2 : weakCount <= 3 ? 1 : 0; // 0-3 pts: no weak phrases
  score -= Math.min(fpCount, 2);                 // penalty: first-person
  score -= Math.min(Math.floor(fillerCount / 3), 2); // penalty: filler words
  score = Math.max(0, Math.min(score, 15));

  return {
    score,
    avCount, avScore,
    quantCount: quantMatches.length, quantScore,
    weakCount, fpCount, fillerCount, pastVerbs,
    bullets: bullets.length,
  };
}

